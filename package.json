{
  "name": "@observerly/orderly",
  "version": "0.0.0",
  "description": "Single file, no pushing. Type-safe middleware that brings a little bit of order to Cloudflare Queues.",
  "keywords": [
    "cloudflare",
    "middleware",
    "queues",
    "typescript",
    "workerd",
    "workers"
  ],
  "homepage": "https://github.com/michealroberts/orderly#readme",
  "bugs": {
    "url": "https://github.com/michealroberts/orderly/issues"
  },
  "license": "MIT",
  "author": "Michael Roberts <michael@observerly.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michealroberts/orderly.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
