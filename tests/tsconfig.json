{
  // Tests inherit the library's strictness but need a wider type surface: the
  // pool contributes the `cloudflare:test` module, which src must never see.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // `types` replaces rather than merges when extending, so the workerd
    // globals have to be repeated here alongside the pool's own types.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  // This project covers every TypeScript file that is not shipped: the tests
  // themselves plus the root tooling configs. Those are kept out of the root
  // project so that it describes only what ends up in the published bundle.
  "include": ["./**/*.ts", "../vitest.config.ts", "../rolldown.config.ts"]
}
