{
  // The composed devContainer.schema.json cannot be loaded by editors: it is a
  // stub with no $id whose first reference is relative, so there is no base URI
  // to resolve it against. The base schema is self-contained and covers every
  // property used here.
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "orderly",
  // javascript-node publishes Node 26 as a stable tag, which is the version
  // pinned in .nvmrc. The typescript-node variant only offers 26 as a
  // prerelease, and installs a global TypeScript this project does not use,
  // since TypeScript is a dev dependency here.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26-trixie",
  // pnpm is already present: the published image bakes in the devcontainers
  // node feature, which installs pnpm by default. corepack is deliberately not
  // used here, as Node 26 no longer bundles it and this image does not add it.
  // The install also puts the lefthook pre-commit hook in place, so a fresh
  // container is ready to commit without a further step.
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "vitest.explorer"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode"
      }
    }
  }
}
